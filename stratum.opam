opam-version: "2.0"
synopsis: "Cosmos DB REST API-compatible document store backed by PostgreSQL"
maintainer: ["Morten Knaack <knaack@gmail.com>"]
authors: ["Morten Knaack <knaack@gmail.com>"]
homepage: "https://github.com/mknaack/stratum"
